@model IEnumerable<EcommerceApp.Controllers.CartItemViewModel>

@{
    ViewData["Title"] = "Shopping Cart";
    decimal grandTotal = Model.Sum(i => i.Total);
}

<h1>Shopping Cart</h1>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>$@item.Price</td>
                    <td>@item.Quantity</td>
                    <td>$@item.Total</td>
                    <td>
                        <a asp-action="Remove" asp-route-productId="@item.ProductId" class="btn btn-danger btn-sm">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end"><strong>Total:</strong></td>
                <td><strong>$@grandTotal</strong></td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex justify-content-between">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Continue Shopping</a>
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-success">Proceed to Checkout</a>
    </div>
}
